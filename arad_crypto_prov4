# ---------- SYMBOL DISCOVERY ----------

def get_symbols():
    contracts_result = api_get("/api/v1/contract/detail")
    contracts = contracts_result.get("data", [])
    if not isinstance(contracts, list):
        raise RuntimeError("Unexpected MEXC contract list format.")

    active = set()
    for item in contracts:
        if (item.get("quoteCoin") == "USDT"
                and item.get("settleCoin") == "USDT"
                and item.get("futureType") == 1):
            active.add(item["symbol"])
    if not active:
        raise RuntimeError("No USDT perpetual contracts found.")

    memes = [s for s in MEME_COINS if s in active]
    tickers_result = api_get("/api/v1/contract/ticker")
    tickers = tickers_result.get("data", [])
    if isinstance(tickers, dict):
        tickers = [tickers]
    if not isinstance(tickers, list):
        raise RuntimeError("Unexpected MEXC ticker format.")

    valid = [
        x for x in tickers
        if x.get("symbol") in active and float(x.get("amount24") or 0) > 0
    ]
    valid.sort(key=lambda x: float(x.get("amount24") or 0), reverse=True)
    top = [x["symbol"] for x in valid[:MAX_COINS]]
    selected = list(dict.fromkeys(memes + top))

    print("Active USDT perpetual contracts:", len(active))
    print("Meme coins included:", len(memes))
    print("Top liquid coins selected:", len(top))
    return selected


# ---------- SIGNAL HISTORY ----------

def load_state():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_state(state):
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)


def can_send(signal, state):
    key = signal["symbol"] + "_" + signal["direction"]
    return time.time() - state.get(key, 0) >= COOLDOWN_HOURS * 3600


# ---------- MAIN ----------

def main():
    print("ARAD CRYPTO PRO V4 started.")
    print("Data source: MEXC Futures")
    print("UTC:", datetime.now(timezone.utc).isoformat())

    if not BOT_TOKEN or not CHAT_ID:
        raise RuntimeError("BOT_TOKEN or CHAT_ID is missing.")

    state = load_state()
    try:
        symbols = get_symbols()
    except Exception as exc:
        message = ("⚠️ ARAD CRYPTO PRO V4\n"
                   "دریافت اطلاعات بازار MEXC ناموفق بود.\n"
                   f"خطا: {str(exc)[:300]}")
        print(message)
        telegram_send(message)
        raise

    print("Symbols to scan:", len(symbols))
    sent_count = 0

    for index, symbol in enumerate(symbols, start=1):
        print(f"[{index}/{len(symbols)}] Scanning {symbol}")
        signal = make_signal(symbol)
        if signal is None:
            time.sleep(REQUEST_DELAY)
            continue
        if not can_send(signal, state):
            print("Cooldown active:", symbol)
            time.sleep(REQUEST_DELAY)
            continue

        if telegram_send(format_signal(signal)):
            key = signal["symbol"] + "_" + signal["direction"]
            state[key] = time.time()
            save_state(state)
            sent_count += 1
            print("Signal sent:", symbol)
        time.sleep(REQUEST_DELAY)

    print("Scan completed. Signals sent:", sent_count)


if __name__ == "__main__":
    main()
